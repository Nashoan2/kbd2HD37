<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item
                android:bottom="3.5dp"
                android:left="3dp"
                android:right="3dp"
                android:top="3.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#142646" />
                    <stroke
                        android:width="2dp"
                        android:color="#3CE2FF" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:bottom="3.5dp"
                android:left="3dp"
                android:right="3dp"
                android:top="3.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#071026" />
                    <stroke
                        android:width="1.8dp"
                        android:color="#00D2FF" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
